      },
      {
        "name": "Visibility button",
        "token": "PasswordInput.VisibilityButton",
        "acceptsChildren": true,
        "propsOrder": ["position"]
      },
      {
        "name": "After",
        "token": "PasswordInput.After",
        "acceptsChildren": true
      }
    ]
  }
}
