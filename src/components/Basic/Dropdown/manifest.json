{
  "name": "Dropdown",
  "version": "1.1.3",
  "description": "Selectable list with a scrollable options panel",
  "editor": {
    "icon": "dropdown",
    "category": "Inputs",
    "focusable": true,
    "propsOrder": ["value", "multiple", "disabled"],
    "hiddenProps": ["class-disabled"],
    "slots": [
      {
        "name": "Trigger",
        "token": "Dropdown.Trigger"
      },
      {
        "name": "Placeholder",
        "token": "Dropdown.Placeholder",
        "textProp": "children"
      },
      {
        "name": "Icon",
        "token": "Dropdown.Icon",
        "acceptsChildren": true
      },
      {
        "name": "Options",
        "token": "Dropdown.Options",
        "hiddenProps": ["inverted-class"],
        "slots": [
          {
            "name": "Option",
            "token": "Dropdown.Option",
            "repeat": true,
            "textProp": "children",
            "propsOrder": ["value", "selected", "disabled"],
            "hiddenProps": ["class-selected", "class-disabled"]
          }
        ],
        "children": {
          "accepts": ["Dropdown.Option"],
          "addLabel": "Add option"
        }
      },
      {
        "name": "Track",
        "token": "Dropdown.Track"
      },
      {
        "name": "Handle",
        "token": "Dropdown.Handle"
      }
    ]
  }
}
