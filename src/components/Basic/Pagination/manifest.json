{
  "name": "Pagination",
  "version": "1.1.2",
  "description": "Page navigation control",
  "editor": {
    "icon": "pagination",
    "category": "Navigation",
    "focusable": true,
    "propsOrder": ["pageSize", "pageIndex", "hasNumbers", "loop"],
    "slots": [
      {
        "name": "Page",
