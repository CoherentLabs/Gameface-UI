{
  "name": "RadioGroup",
  "version": "1.1.2",
  "description": "Group of mutually exclusive radio options",
  "editor": {
    "icon": "radio",
    "category": "Inputs",
    "entry": "Radio.tsx",
    "propsOrder": ["disabled"],
    "hiddenProps": ["class-disabled"],
    "slots": [
      {
        "name": "Button",
        "token": "Radio.Button",
        "repeat": true,
        "textProp": "children",
        "propsOrder": ["value", "selected", "disabled"],
        "hiddenProps": ["class-disabled", "class-selected"],
        "slots": [
          {
            "name": "Label",
            "token": "Radio.ButtonLabel",
            "textProp": "children",
            "styleable": false,
            "acceptsChildren": true
          },
          {
            "name": "Control",
            "token": "Radio.ButtonControl",
            "slots": [
              {
                "name": "Indicator",
                "token": "Radio.ButtonIndicator"
              }
            ]
          }
        ]
      }
    ],
    "children": {
      "accepts": ["Radio.Button"],
      "addLabel": "Add option"
    }
  }
}
