{
  "name": "Grid",
  "version": "1.1.2",
  "description": "CSS grid container",
  "editor": {
    "icon": "layout-grid",
    "category": "Layout",
    "propsOrder": ["rows", "cols", "gap", "row-gap", "column-gap"],
    "hiddenProps": ["row-style", "column-style", "row-class", "column-class"],
    "slots": [
      {
        "name": "Tile",
